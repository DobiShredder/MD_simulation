# 첫 frame RMSD와 average structure를 계산합니다.
autoimage anchor :1-10
rms ToFirst first :1-10@CA,C,N out rmsd_first.dat
average crdset Average :1-10
run

crdout Average average.pdb pdb

# Average structure에 다시 fitting한 뒤 RMSD, RMSF와 Rg를 계산합니다.
autoimage anchor :1-10
rms ToAverage ref Average :1-10@CA,C,N out rmsd_average.dat
atomicfluct RMSF :1-10@CA,C,N byres out rmsf_byres.dat
radgyr Rg :1-10&!@H= mass nomax out rg.dat
run
