# Calculate the overall Chignolin size and the approach between the two strands.
# Residues 5-6 are skipped so the covalent C(5)-N(6) bond does not set the minimum.
autoimage anchor :1-10

distance TerminalDistance :1@CA :10@CA out geometry.dat
mindist mask1 :1-4&!@H= mask2 :7-10&!@H= byatom name MinStrandDistance out geometry.dat
angle BendAngle :1@CA :5@CA :10@CA out geometry.dat

# Identify standard protein-backbone phi/psi angles for residues 2-9.
multidihedral Backbone phi psi resrange 2-9 out phi_psi.dat
run
