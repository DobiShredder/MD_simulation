# Fit the backbone to the first frame after imaging, then remove solvent and ions.
autoimage anchor :1-10

rms BeforeFit first :1-10@CA,C,N nofit out rmsd_before.dat
rms AfterFit first :1-10@CA,C,N out rmsd_after.dat
average average.pdb :1-10 pdb

strip :WAT,Na+,Cl- parmout stripped.parm7 nobox
trajout aligned.nc netcdf nobox
run
