MM/GBSA for T4 lysozyme-JZ4
&general
# Frame range: endframe=9999999 is the MMPBSA.py default and reads to the
# last frame. Set startframe/endframe/interval to analyse a subset.
 startframe=1,
 endframe=9999999,
 interval=1,
 keep_files=0,
 netcdf=1,
 verbose=2,
/
&gb
 igb=5,
 saltcon=0.15,
 molsurf=0,
/
&decomp
 idecomp=2,
 dec_verbose=0,
/
