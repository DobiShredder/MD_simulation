source leaprc.protein.ff19SB
source leaprc.gaff2
source leaprc.water.tip3p

loadamberparams ben.frcmod
BEN = loadmol2 ben.mol2

system = loadpdb complex.pdb
source disulfides.leap
check system

# MAXS=3.7 nm 범위에서 protein periodic image와의 접촉을 줄인다.
solvatebox system TIP3PBOX 20.0
addionsrand system Na+ 0
addionsrand system Cl- 0

saveamberparm system system.parm7 system.rst7
savepdb system system.pdb
quit
