source leaprc.gaff2
source leaprc.water.opc

loadamberparams bnz.frcmod
loadamberparams mbn.frcmod
BNZ = loadmol2 bnz.mol2
MBN = loadmol2 mbn.mol2
# The crystal pose has heavy atoms only; loadpdb builds the hydrogens
# from the BNZ/MBN mol2 templates.
bnz_pose = loadpdb bound_bnz.pdb
mbn_pose = loadpdb bound_mbn.pdb

system = combine { bnz_pose mbn_pose }
solvatebox system OPCBOX 20.0

saveamberparm system solvent.parm7 solvent.rst7
savepdb system solvent.pdb
quit
